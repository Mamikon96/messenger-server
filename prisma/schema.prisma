generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  direct
  group
}

enum ChatRole {
  owner
  member
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  login        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @default("") @map("last_name")
  /// Производное: `btrim(first_name || ' ' || last_name)`; пишет код, согласованность держит CHECK `users_name_matches_parts`.
  name         String
  avatarUrl    String    @map("avatar_url")
  isAdmin      Boolean   @default(false) @map("is_admin")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions     Session[]
  createdChats Chat[]
  memberships  ChatMember[]
  messages     Message[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  csrfToken String   @map("csrf_token")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Chat {
  id          String   @id @default(uuid()) @db.Uuid
  type        ChatType
  title       String?
  directKey   String?  @unique @map("direct_key")
  createdById String   @map("created_by") @db.Uuid
  lastSeq     Int      @default(0) @map("last_seq")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User         @relation(fields: [createdById], references: [id])
  members   ChatMember[]
  messages  Message[]

  @@map("chats")
}

model ChatMember {
  chatId      String   @map("chat_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        ChatRole @default(member)
  lastReadSeq Int      @default(0) @map("last_read_seq")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  seq       Int
  senderId  String   @map("sender_id") @db.Uuid
  clientId  String   @map("client_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@unique([chatId, seq])
  @@unique([chatId, senderId, clientId])
  @@map("messages")
}
