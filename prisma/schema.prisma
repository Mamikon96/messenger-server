generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InviteKind {
  join
  recovery
}

enum ChatType {
  direct
  group
}

enum ChatRole {
  owner
  member
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  webauthnUserId Bytes     @unique @map("webauthn_user_id")
  name           String
  avatarUrl      String    @map("avatar_url")
  isAdmin        Boolean   @default(false) @map("is_admin")
  disabledAt     DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions        Session[]
  passkeys        Passkey[]
  createdChats    Chat[]
  memberships     ChatMember[]
  messages        Message[]
  invitesCreated  Invite[]            @relation("InviteCreatedBy")
  invitesUsed     Invite[]            @relation("InviteUsedBy")
  recoveryInvites Invite[]            @relation("InviteTarget")
  challenges      WebauthnChallenge[]

  @@map("users")
}

model Passkey {
  id         String    @id
  userId     String    @map("user_id") @db.Uuid
  publicKey  Bytes     @map("public_key")
  counter    BigInt
  transports String[]
  deviceType String    @map("device_type")
  backedUp   Boolean   @map("backed_up")
  name       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model Invite {
  id          String     @id @default(uuid()) @db.Uuid
  tokenHash   String     @unique @map("token_hash")
  kind        InviteKind
  userId      String?    @map("user_id") @db.Uuid
  makeAdmin   Boolean    @default(false) @map("make_admin")
  createdById String?    @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?  @map("used_at") @db.Timestamptz(3)
  usedById    String?    @map("used_by") @db.Uuid
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)

  user       User?               @relation("InviteTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy     User?               @relation("InviteUsedBy", fields: [usedById], references: [id])
  challenges WebauthnChallenge[]

  @@map("invites")
}

model WebauthnChallenge {
  id             String   @id @default(uuid()) @db.Uuid
  challenge      String
  purpose        String
  inviteId       String?  @map("invite_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  webauthnUserId Bytes?   @map("webauthn_user_id")
  name           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  invite Invite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  csrfToken String   @map("csrf_token")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Chat {
  id          String   @id @default(uuid()) @db.Uuid
  type        ChatType
  title       String?
  directKey   String?  @unique @map("direct_key")
  createdById String   @map("created_by") @db.Uuid
  lastSeq     Int      @default(0) @map("last_seq")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User         @relation(fields: [createdById], references: [id])
  members   ChatMember[]
  messages  Message[]

  @@map("chats")
}

model ChatMember {
  chatId      String   @map("chat_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        ChatRole @default(member)
  lastReadSeq Int      @default(0) @map("last_read_seq")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  seq       Int
  senderId  String   @map("sender_id") @db.Uuid
  clientId  String   @map("client_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@unique([chatId, seq])
  @@unique([chatId, senderId, clientId])
  @@map("messages")
}
